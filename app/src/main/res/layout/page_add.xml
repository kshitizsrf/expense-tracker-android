<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroung_gradient"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:titleTextColor="@color/white">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:backgroundTint="@android:color/transparent"
            android:clickable="true"
            android:src="@drawable/baseline_arrow_back_ios_24"
            android:stateListAnimator="@animator/button_state_list_animator"
            app:borderWidth="0dp"
            app:elevation="0dp"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Add Transaction"
            android:textColor="@color/white"
            android:textSize="22dp" />
    </androidx.appcompat.widget.Toolbar>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_below="@id/toolbar"
        app:cardCornerRadius="28dp"
        android:layout_marginBottom="-20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="#EDEDED">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="50dp"
                >
                <EditText
                    android:layout_width="180dp"
                    android:layout_height="70dp"
                    android:hint="Budget Amount"
                    android:padding="10dp"
                    android:background="@drawable/round_shape_for_tabs"
                    android:layout_marginVertical="20dp"
                    android:textColor="@color/black"
                    android:textColorHint="#B3292D32"
                    android:textStyle="bold"
                    android:textSize="20dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:layout_gravity="center"
                    />
                <EditText
                    android:id="@+id/category"
                    android:layout_marginVertical="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:drawableStart="@drawable/category_txt"
                    android:drawablePadding="12dp"
                    android:background="@drawable/edittext_design_addpage"
                    android:ems="10"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColorHint="#B3292D32"
                    android:hint="Select Category"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">
                    <EditText
                        android:id="@+id/date"
                        android:layout_marginEnd="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Date"
                        android:ems="10"
                        android:textColorHint="#B3292D32"
                        android:drawableStart="@drawable/date"
                        android:drawablePadding="12dp"
                        android:background="@drawable/edittext_design_addpage"
                        android:focusable="false"
                        android:inputType="none"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        />
                    <EditText
                        android:id="@+id/time"
                        android:layout_marginStart="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Time"
                        android:textColorHint="#B3292D32"
                        android:drawableStart="@drawable/time"
                        android:drawablePadding="12dp"
                        android:ems="10"
                        android:background="@drawable/edittext_design_addpage"
                        android:layout_weight="1"
                        android:focusable="false"
                        android:inputType="none"
                        android:textColor="@color/black"
                        android:layout_gravity="center"

                        />
                </LinearLayout>
                <EditText
                    android:layout_marginVertical="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Notes"
                    android:drawableStart="@drawable/note_text_svgrepo_com"
                    android:drawablePadding="12dp"
                    android:textColorHint="#B3292D32"
                    android:background="@drawable/edittext_design_addpage"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@+id/space"
                    android:layout_gravity="bottom">

                    <Button
                        android:id="@+id/submit"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:backgroundTint="#004E92"
                        android:text="Submit"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="#fff" />

                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
