<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Toolbar title text style -->
    <style name="ToolbarTitleText">
        <item name="android:textSize">18sp</item> <!-- Adjust the text size as needed -->
        <item name="android:textColor">@android:color/white</item> <!-- Set text color -->
        <item name="android:textStyle">bold</item> <!-- Set text style: normal, bold, italic, etc. -->
        <!-- Add more style attributes as needed -->
    </style>

    <style name="CustomDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">#F2F2F2</item>
        <item name="android:textColor">#000000</item>
        <item name="android:radius">20dp</item>
        <!-- Add more style attributes if needed -->
    </style>
    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>
    <style name="DialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">?attr/colorOnPrimary</item>

    </style>
    <style name="RoundedBottomSheetDialog" parent="Theme.Design.BottomSheetDialog">
        <item name="android:background">@drawable/bottom_sheet_round_corners</item>
    </style>

    <style name="CustomMaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="materialCalendarStyle">@style/Widget.MaterialComponents.MaterialCalendar</item>
        <item name="colorPrimary">#004E92</item> <!-- Set your accent color -->
        <item name="colorOnPrimary">#FFF</item> <!-- Set color on your accent color -->
    </style>

    <dimen name="amount_size">30dp</dimen>
    <dimen name="def_amount_size">60dp</dimen>


    <style name="AppTheme_theme2" parent="Theme.AppCompat.Light.NoActionBar">
        <!--for background-->
        <item name="android:windowBackground">@drawable/theme2_background_gradient</item>
        <!--for main card view-->
        <item name="colorPrimary">#FCD4C5</item>
        <!--for middle card-->
        <item name="colorPrimaryVariant">#FD794D</item>
        <!--for buttons-->
        <item name="colorOnPrimary">#FD794D</item>
        <!--for text-->
        <item name="android:textColor">@color/black</item>
        <!--for bottom navigation icon-->
        <item name="colorOnSecondary">#202B5F</item>
        <!--for bottom navigation-->
        <item name="colorSecondary">#FCD4C5</item>
        <!--for home  texts-->
        <item name="colorSecondaryVariant">#FD794D</item>
        <!--for numpad -->
        <item name="colorTertiary">#FFC5AF</item>
        <!--transaction listview-->
        <item name="colorOnTertiary">#1A001F54</item>

        <item name="android:drawableTint">#B3292D32</item>

        <item name="android:statusBarColor">#131B42</item>
    </style>


